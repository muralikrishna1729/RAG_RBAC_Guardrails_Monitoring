# Application environment: development, test, or production
APP_ENV=development
ENABLE_DEMO_USERS=true

# LLM
GROQ_API_KEY=your_groq_api_key_here

# Auth / JWT. Use a unique random value of at least 32 characters in production.
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Browser origins allowed to call the FastAPI API.
# In production, use your real HTTPS frontend origin(s), comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:8501

# Guardrails
COMPANY_DOMAIN=company.com

# Database: local default. Docker Compose uses a persistent shared SQLite file.
DATABASE_URL=sqlite:///./app_auth.db

# Audit logs
AUDIT_LOG_PATH=security_audit.log

# LangSmith tracing (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=RAG_RBAC_Guardrails_Monitoring

# Evaluation (optional)
GEMINI_API_KEY=your_gemini_api_key_here
RAGAS_SAMPLE_SIZE=10
